# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_GRAPH_URL=https://graph.instagram.com
PUBLIC_BASE_URL=

# ngrok
NGROK_AUTH_TOKEN=
# Reserved static domain from https://dashboard.ngrok.com/domains
# (free plan: <name>.ngrok-free.app). When set, start-all.sh prefers ngrok
# over the Cloudflare Quick Tunnel so Instagram sees a stable media host.
NGROK_STATIC_DOMAIN=

# Text model (llama.cpp)
LLAMA_MODEL_PATH=/mnt/data/Models/Bonsai-27B-Q1_0.gguf
LLAMA_PORT=8001

# ComfyUI
COMFYUI_URL=http://localhost:8189
COMFYUI_WORKFLOW_PATH=/home/Darsh/codn/workflows/art_generation.json

# Output
OUTPUT_DIR=/home/Darsh/codn/output
QUOTES_DB=/home/Darsh/codn/quotes.db

# App
APP_HOST=0.0.0.0
APP_PORT=4000

# Auth — required. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Optional extra Host-header allowlist (comma-separated) when accessing the
# dashboard via a LAN IP or custom domain. Localhost, 127.0.0.1, ngrok and
# Cloudflare tunnel hosts are always allowed.
# ALLOWED_HOSTS=
